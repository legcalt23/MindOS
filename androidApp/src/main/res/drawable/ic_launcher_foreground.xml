<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: MindOS mark on a 108dp canvas, with the visual content
    constrained to the inner 72dp safe zone per Android adaptive icon guidelines.
    The mark is a stylised "N" rendered as three strokes (left vertical, diagonal,
    right vertical) in the MindOS green so it stays legible against the dark background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left vertical stroke. -->
    <path
        android:strokeWidth="9"
        android:strokeColor="#13ECA4"
        android:strokeLineCap="round"
        android:pathData="M 38,38 L 38,70" />

    <!-- Diagonal stroke. -->
    <path
        android:strokeWidth="9"
        android:strokeColor="#13ECA4"
        android:strokeLineCap="round"
        android:pathData="M 38,38 L 70,70" />

    <!-- Right vertical stroke. -->
    <path
        android:strokeWidth="9"
        android:strokeColor="#13ECA4"
        android:strokeLineCap="round"
        android:pathData="M 70,38 L 70,70" />
</vector>
