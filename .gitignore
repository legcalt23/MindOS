.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.staging

# Firebase service-account / admin keys
firebase-adminsdk-*.json
serviceAccountKey*.json
*-service-account*.json
google-services-secrets.json

# Generic credential / private-key patterns
*.pem
*.p12
*.key
*_rsa
*_rsa.pub
id_rsa*
*.pfx

