# ──────────────────────────────────────────────────────────────────────────
# NEU — root .env.example
#
# This file is COMMITTED. Real .env is NOT (see .gitignore).
# Copy to `.env` and fill values for your local environment.
#
# None of these values are secrets in the placeholder form.
# Real production secrets are stored in Firebase Functions runtime config
# and Google Secret Manager — NEVER in this file.
# ──────────────────────────────────────────────────────────────────────────

# Firebase project — your local/dev project ID (not production)
FIREBASE_PROJECT_ID=neuv3-dev

# Emulator endpoints (defaults from firebase.json)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# Optional: app-check debug token for local testing only.
# Generate one via the Firebase Console for your dev app and paste here.
# This bypasses App Check enforcement in dev — never use in production.
APP_CHECK_DEBUG_TOKEN=

# Set to "true" to log structured wallet events at debug level locally.
NEU_WALLET_LOG_DEBUG=false
