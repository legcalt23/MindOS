{
  "permissions": {
    "allow": [
      "PowerShell(.\\gradlew.bat :shared:desktopTest:*)",
      "PowerShell(.\\gradlew.bat :shared:compileKotlinDesktop:*)",
      "PowerShell(.\\gradlew.bat :shared:detekt:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__plugin_firebase_firebase__firebase_deploy_status",
      "mcp__plugin_firebase_firebase__firebase_list_apps",
      "mcp__plugin_firebase_firebase__firebase_get_environment",
      "mcp__plugin_firebase_firebase__firebase_validate_security_rules"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path');const d=process.env.CLAUDE_PROJECT_DIR||process.cwd();require(p.join(d,'.claude','hooks','mindos-guard.cjs'))\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path');const d=process.env.CLAUDE_PROJECT_DIR||process.cwd();require(p.join(d,'.claude','hooks','mindos-guard.cjs'))\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path');const d=process.env.CLAUDE_PROJECT_DIR||process.cwd();require(p.join(d,'.claude','hooks','mindos-guard.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path');const d=process.env.CLAUDE_PROJECT_DIR||process.cwd();require(p.join(d,'.claude','hooks','mindos-guard.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
