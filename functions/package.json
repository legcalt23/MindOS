{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "scan:secrets": "node scripts/scan-secrets.js",
    "audit:deps": "npm audit --omit=dev --json | node scripts/audit-threshold.js high",
    "verify": "npm run scan:secrets && npm run typecheck && npm test",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "firebase-functions-test": "^3.5.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.10",
    "typescript": "^5.0.0"
  },
  "private": true
}
