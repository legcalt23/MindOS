# ── Secrets — never commit any of these ────────────────────────────────
# .env files (real values). .env.example IS committed (no secrets).
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.staging

# Firebase service-account / admin keys
firebase-adminsdk-*.json
serviceAccountKey*.json
*-service-account*.json
google-services-secrets.json

# Generic credential / private-key patterns
*.pem
*.p12
*.key
*_rsa
*_rsa.pub
id_rsa*
*.pfx

# Android signing keystores — NEVER commit. Distribute via secure channel
# (1Password / secrets vault / encrypted backup). See gradle.properties.example
# for the variable names the signing config reads.
*.jks
*.keystore
key.properties
keystore.properties
release-keystore.properties
# Root gradle.properties may hold real keystore credentials on a dev machine.
# The committed gradle.properties at repo root only holds non-secret JVM options
# — it stays tracked. Any developer-local overrides go to ~/.gradle/gradle.properties.
/androidApp/keystore/
/androidApp/*.jks
/androidApp/*.keystore

# ── Logs / debug artifacts ────────────────────────────────────────────
*.log
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
build_log*.txt
build_output*.log
build_appcheck.log

# Local emulator state
.firebase/
firestore-export/

# ── Personal AI-conversation exports / ad-hoc dumps (NEVER commit) ─────
# Full ChatGPT/Claude-style conversation exports and their extraction scratch
# files. These are personal/business data, not product source; keep them out
# of git so an accidental `git add -A` cannot capture them and bake them into
# history permanently. Patterns anchored to repo root per the gitignore
# anchoring rule (see CLAUDE.md 2026-05-30). (Secrets audit 2026-06-30.)
/extracted_conversations.txt
/last_conv.txt
/neu_conversations_summary.txt
/top_neu_conversations.txt
/zip_files.txt
/zip_contents.txt
/conversations-*.json
/shared_conversations.json
/export_manifest.json
/mindboost-antigravity-team-system-v1.zip

# Local-only physical/emulator validation captures (§15 Velocidad Mental): device
# screenshots and raw DebugExport JSON/CSV are sensitive (timestamps, behavior,
# account emails) and must never be committed (§16). Per-machine scratch dir.
/validation/

# ── IDE / editor swap files ───────────────────────────────────────────
.idea/
*.swp
*.swo
*.bak
*~

# ── Built / generated KMP artifacts at repo root ──────────────────────
*.class
androidApp/release/*.apk
androidApp/release/output-metadata.json

# ── Claude Code runtime state (toolkit under .claude/ IS committed) ────
# Only ignore per-machine runtime artifacts, never the curated toolkit
# (agents/rules/skills/commands/hooks/README stay tracked).
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/settings.local.json

# ── MindBoost Memory Layer ─────────────────────────────────────────────
# The engine (.claude/memory/) and the source of truth (docs/memory/) ARE
# committed. The INDEX is a disposable, per-worktree, rebuildable cache —
# never commit the DB, downloaded models, audit log, or staleness manifest.
.claude/.memory/
.claude/memory/node_modules/
.claude/memory/package-lock.json

