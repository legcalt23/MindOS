<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="dm_audio/" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="com.google.firebase.crashlytics-ndk" />
        <exclude domain="file" path="generate_fid.lock" />
        <exclude domain="file" path="PersistedInstallation" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="dm_audio/" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="com.google.firebase.crashlytics-ndk" />
        <exclude domain="file" path="generate_fid.lock" />
        <exclude domain="file" path="PersistedInstallation" />
    </device-transfer>
</data-extraction-rules>
