{
  "scripts": {
    "check:release-evidence": "node scripts/check-release-evidence.mjs --validate",
    "check:release-go": "node scripts/check-release-evidence.mjs --require-go",
    "test:release-gates": "node --test scripts/check-release-evidence.test.mjs",
    "check:audit-ledger": "node scripts/validate-audit-ledger.mjs",
    "check:authority-entrypoints": "node scripts/validate-authority-entrypoints.mjs",
    "test:authority-entrypoints": "node --test scripts/validate-authority-entrypoints.test.mjs",
    "check:governance": "npm run check:audit-ledger && npm run check:authority-entrypoints",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project mindos-username-rules \"node firestore.username.rules.test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project mindos-storage-metadata-rules \"node storage.dm.rules.test.mjs\"",
    "test:storage-rules:static": "node functions/scripts/check-storage-rules.js",
    "test:security-rules": "firebase emulators:exec --only firestore --project mindos-security-audit \"node firestore.security.rules.test.mjs\"",
    "test:counter-shards-emulator": "npm run build --prefix functions && firebase emulators:exec --only firestore --project mindos-counter-shards \"node functions/scripts/counter-shards.concurrency.emulator.mjs\"",
    "test:rules": "npm run test:storage-rules:static && npm run test:storage-rules && npm run test:firestore-rules && npm run test:security-rules",
    "memory:build": "graphify update . && graphify tree",
    "memory:update": "graphify update .",
    "memory:watch": "graphify watch ."
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.13.0",
    "firebase-tools": "^15.22.0"
  },
  "overrides": {
    "uuid@<11.1.1": "11.1.1",
    "@grpc/grpc-js@<1.9.16": "1.14.4",
    "form-data@>=4.0.0 <4.0.6": "4.0.6",
    "hono@<4.12.25": "4.12.25",
    "protobufjs@<=7.6.2": "7.6.3"
  },
  "dependencies": {
    "agent-browser": "^0.31.1"
  }
}
