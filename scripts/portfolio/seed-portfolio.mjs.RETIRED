    DESIGN({ canonicalExerciseId: 'DECIDE_PRESUPUESTO', designExerciseId: 'E7_Presupuesto', canonicalFamilyId: 'DECIDE_RESOURCE', primarySubskill: 'resource_allocation' }),
    DESIGN({ canonicalExerciseId: 'DECIDE_AMBIGUEDAD', designExerciseId: 'E8_Resolucion_Ambiguedad', canonicalFamilyId: 'DECIDE_UNCERTAINTY', primarySubskill: 'decision_under_ambiguity' }),
  ] },
  EMOTION: { label: 'Emociones', ex: [
    LIVE({ canonicalExerciseId: 'EMO_PAUSA', codeExerciseId: 'EM1_PAUSA', designExerciseId: 'EM-A_Freno_Senuelo', canonicalFamilyId: 'EMO_INHIBITION', primarySubskill: 'pause_before_action', ...src('EM1_PAUSA') }),
    LIVE({ canonicalExerciseId: 'EMO_RECUPERACION', codeExerciseId: 'EM2_RECUPERACION', designExerciseId: 'EM-B_Reentrada_Error', canonicalFamilyId: 'EMO_RECOVERY', primarySubskill: 'post_error_recovery', ...src('EM2_RECUPERACION') }),
    LIVE({ canonicalExerciseId: 'EMO_SEPARADOR', codeExerciseId: 'EM3_SEPARADOR', designExerciseId: 'EM-C_Separador_Quad', canonicalFamilyId: 'EMO_GRANULARITY', primarySubskill: 'emotion_thought_separation', ...src('EM3_SEPARADOR') }),
    CATALOG({ canonicalExerciseId: 'EMO_CALIBRADOR', codeExerciseId: 'EM4_CALIBRADOR', designExerciseId: 'EM-E_Calibrador', canonicalFamilyId: 'EMO_CALIBRATION', primarySubskill: 'calibration_accuracy', ...src('EM4_CALIBRADOR') }),
    CATALOG({ canonicalExerciseId: 'EMO_SESGO', codeExerciseId: 'EM5_SESGO_AFECTIVO', designExerciseId: 'EM-G_Estabilidad_Interferencia', canonicalFamilyId: 'EMO_STABILITY', primarySubskill: 'affective_decision_quality', ...src('EM5_SESGO_AFECTIVO') }),
    CATALOG({ canonicalExerciseId: 'EMO_TOLERANCIA', codeExerciseId: 'EM6_TOLERANCIA', designExerciseId: 'EM-D_Espera_Calibrada', canonicalFamilyId: 'EMO_TOLERANCE', primarySubskill: 'frustration_tolerance', ...src('EM6_TOLERANCIA') }),
    CATALOG({ canonicalExerciseId: 'EMO_REENTRADA', codeExerciseId: 'EM7_REENTRADA', designExerciseId: 'Reentrada_tras_Pausa', canonicalFamilyId: 'EMO_STABILITY', primarySubskill: 'regulation_stability', ...src('EM7_REENTRADA') }),
    LIVE({ canonicalExerciseId: 'EMO_ANTIIMPULSO', codeExerciseId: 'EM8_ANTIIMPULSO', designExerciseId: 'Anti_impulso', canonicalFamilyId: 'EMO_INHIBITION', primarySubskill: 'pause_before_action', ...src('EM8_ANTIIMPULSO') }),
    CATALOG({ canonicalExerciseId: 'EMO_ETIQUETADO', codeExerciseId: 'EM9_ETIQUETADO', designExerciseId: 'EM-F_Etiquetado', canonicalFamilyId: 'EMO_GRANULARITY', primarySubskill: 'granularity', ...src('EM9_ETIQUETADO') }),
    LIVE({ canonicalExerciseId: 'EMO_SEP_PRESION', codeExerciseId: 'EM10_SEP_PRESION', designExerciseId: 'Separacion_bajo_Presion', canonicalFamilyId: 'EMO_GRANULARITY', primarySubskill: 'emotion_thought_separation', ...src('EM10_SEP_PRESION') }),
    LIVE({ canonicalExerciseId: 'EMO_CONTINUIDAD', codeExerciseId: 'EM11_FEEDBACK_NEG', designExerciseId: 'Continuidad_tras_Error', canonicalFamilyId: 'EMO_RECOVERY', primarySubskill: 'post_error_recovery', ...src('EM11_FEEDBACK_NEG') }),
    CATALOG({ canonicalExerciseId: 'EMO_ESPERA', codeExerciseId: 'EM12_ESPERA', designExerciseId: 'Espera_Activa', canonicalFamilyId: 'EMO_INHIBITION', primarySubskill: 'pause_before_action', ...src('EM12_ESPERA') }),
    CATALOG({ canonicalExerciseId: 'EMO_VARIABILIDAD', codeExerciseId: 'EM13_VARIABILIDAD', designExerciseId: 'Variabilidad', canonicalFamilyId: 'EMO_STABILITY', primarySubskill: 'regulation_stability', ...src('EM13_VARIABILIDAD') }),
    CATALOG({ canonicalExerciseId: 'EMO_CONFIANZA', codeExerciseId: 'EM14_CONFIANZA', designExerciseId: 'Calibracion_Confianza', canonicalFamilyId: 'EMO_CALIBRATION', primarySubskill: 'calibration_accuracy', ...src('EM14_CONFIANZA') }),
    CATALOG({ canonicalExerciseId: 'EMO_RECUP_CADENA', codeExerciseId: 'EM15_RECUP_CADENA', designExerciseId: 'Recuperacion_Encadenada', canonicalFamilyId: 'EMO_RECOVERY', primarySubskill: 'post_error_recovery', ...src('EM15_RECUP_CADENA') }),
  ] },
  CREATE: { label: 'Creatividad', ex: [
    LIVE({ canonicalExerciseId: 'CREATE_SUPRESION', codeExerciseId: 'EX01_SUPPRESS_FIRST_IDEA', designExerciseId: 'Supresion_Primer_Impulso', canonicalFamilyId: 'CREATE_INHIBITION', primarySubskill: 'prepotent_inhibition', ...src('EX01_SUPPRESS_FIRST_IDEA'), blockers: 'no-per-exercise-QA;ios-unverified;AI-scoring-BLOCKED' }),
    LIVE({ canonicalExerciseId: 'CREATE_ROTACION', codeExerciseId: 'EX02_CATEGORY_ROTATION', designExerciseId: 'Rotacion_Categorias', canonicalFamilyId: 'CREATE_FLEXIBILITY', primarySubskill: 'semantic_switching', ...src('EX02_CATEGORY_ROTATION'), blockers: 'no-per-exercise-QA;ios-unverified;AI-scoring-BLOCKED' }),
    DESIGN({ canonicalExerciseId: 'CREATE_SINTESIS', designExerciseId: 'Sintesis_Bajo_Restriccion', canonicalFamilyId: 'CREATE_CONVERGENT', primarySubskill: 'convergent_combination' }),
    DESIGN({ canonicalExerciseId: 'CREATE_ANALOGIAS', designExerciseId: 'Analogias_Remotas', canonicalFamilyId: 'CREATE_ASSOCIATION', primarySubskill: 'remote_association' }),
    DESIGN({ canonicalExerciseId: 'CREATE_ELABORACION', designExerciseId: 'Elaboracion_Incremental', canonicalFamilyId: 'CREATE_ELABORATION', primarySubskill: 'idea_elaboration' }),
    DESIGN({ canonicalExerciseId: 'CREATE_INVEROSIMIL', designExerciseId: 'Deteccion_Inverosimil', canonicalFamilyId: 'CREATE_CONSTRAINT', primarySubskill: 'negative_constraint_originality' }),
    DESIGN({ canonicalExerciseId: 'CREATE_REENCUADRE', designExerciseId: 'Reencuadre_Problema', canonicalFamilyId: 'CREATE_REFRAME', primarySubskill: 'problem_finding' }),
    DESIGN({ canonicalExerciseId: 'CREATE_IMPROVISACION', designExerciseId: 'Improvisacion_Restringida', canonicalFamilyId: 'CREATE_FLUENCY', primarySubskill: 'fluency_under_pressure' }),
  ] },
};
const ORDER = ['FOCUS', 'SPEED', 'LOGIC', 'LANG', 'MEMORY', 'DECIDE', 'EMOTION', 'CREATE'];

const rows = [];
for (const key of ORDER) {
  const b = BLOCKS[key];
  for (let i = 0; i < 15; i++) {
    const slotId = `${key}-${String(i + 1).padStart(2, '0')}`;
    const ex = b.ex[i];
    if (ex) rows.push({ ...BASE, slotId, block: b.label,
      aliases: [ex.codeExerciseId, ex.designExerciseId].filter(Boolean).join(';') + (ex.aliases ? ';' + ex.aliases : ''), ...ex });
    else rows.push({ ...BASE, slotId, block: b.label, canonicalFamilyId: `${key}_UNASSIGNED`, distinctnessRationale: 'undesigned base slot toward the approved 15/block' });
  }
}
rows.push({ ...BASE, slotId: 'EXTRA-121', block: 'EXTRA', canonicalFamilyId: 'EXTRA_UNASSIGNED', owner: 'CEO', blockers: 'awaiting-CEO-assignment',
  distinctnessRationale: 'the +1 over the 120 base; UNASSIGNED pending CEO decision + value proof; NO candidate (EX16 is an overlay auxiliary, not a candidate)' });
if (rows.length !== 121) { console.error(`FATAL ${rows.length} rows`); process.exit(1); }

const q = (v) => `"${String(v ?? '').replace(/"/g, '""').replace(/,/g, ';')}"`;
const csv = [COLUMNS.join(',')].concat(rows.map((r) => COLUMNS.map((c) => q(r[c])).join(','))).join('\n') + '\n';
writeFileSync(join(root, 'MINDBOOST_EXERCISE_PORTFOLIO.csv'), csv, 'utf8');

const AUX_COLS = ['auxId', 'kind', 'codeExerciseId', 'designExerciseId', 'block', 'relatedTargetSlot', 'reasonExcluded', 'implementationStatus', 'distinctnessReviewStatus', 'epistemicStatus', 'requiresManualReview', 'evidencePaths'];
const aux = [
  { auxId: 'AUX-DECIDE-CHECKIN', kind: 'context_checkin', codeExerciseId: 'CheckIn', designExerciseId: 'E4_CheckIn_GoNoGo', block: 'Decisiones', relatedTargetSlot: 'DECIDE flow entry', reasonExcluded: 'entry gate / availability check-in; not a standalone training exercise', implementationStatus: 'LIVE_REACHABLE', distinctnessReviewStatus: 'APPROVED', epistemicStatus: 'VERIFIED', requiresManualReview: 'no', evidencePaths: INV.blocks.DECIDE.declFile },
  { auxId: 'AUX-LOGIC-CONDITIONAL', kind: 'alternate_form', codeExerciseId: 'CONDITIONAL_TEST', designExerciseId: 'Cadena_Deductiva(conditional form)', block: 'Logica', relatedTargetSlot: 'LOGIC-01', reasonExcluded: 'conditional alternate form of Cadena Deductiva (design #1); dedup NOT scientifically verified — could split if distinct construct/scoring proven', implementationStatus: 'LIVE_REACHABLE', distinctnessReviewStatus: 'PROVISIONAL', epistemicStatus: 'INFERRED', requiresManualReview: 'yes', evidencePaths: INV.blocks.LOGIC.declFile },
  { auxId: 'AUX-MEMORY-EX16', kind: 'overlay', codeExerciseId: 'EX16_CALIBRACION_CONFIANZA', designExerciseId: '(none)', block: 'Memoria', relatedTargetSlot: '(transversal)', reasonExcluded: 'transversal confidence-calibration overlay, not a standalone exercise; 16th code id over the 15-slot base; NOT an EXTRA-121 candidate', implementationStatus: 'PARTIAL', distinctnessReviewStatus: 'PROVISIONAL', epistemicStatus: 'INFERRED', requiresManualReview: 'yes', evidencePaths: INV.blocks.MEMORY.declFile },
  { auxId: 'AUX-LANG-MIXED', kind: 'composite', codeExerciseId: 'mixed_session', designExerciseId: '(composite)', block: 'Lenguaje', relatedTargetSlot: 'all LANG', reasonExcluded: 'mixed/composite session over the 6 language exercises; not a distinct mechanic', implementationStatus: 'LIVE_REACHABLE', distinctnessReviewStatus: 'APPROVED', epistemicStatus: 'VERIFIED', requiresManualReview: 'no', evidencePaths: INV.blocks.LANG.declFile },
];
writeFileSync(join(root, 'MINDBOOST_EXERCISE_AUXILIARIES.csv'), [AUX_COLS.join(',')].concat(aux.map((r) => AUX_COLS.map((c) => q(r[c])).join(','))).join('\n') + '\n', 'utf8');
console.log(`SEED OK (V2c): 121 target rows + ${aux.length} auxiliaries; ${COLUMNS.length} columns.`);
