# ──────────────────────────────────────────────────────────────────────────
# functions/.env.example
#
# COMMITTED. Real values go in functions/.env (gitignored) or in
# Firebase Functions runtime config for deployed environments.
#
# Cloud Functions environment variables:
#   - For local: this file (when running emulators with `--env-file`)
#   - For deployed: `firebase functions:config:set` OR Google Secret Manager
# ──────────────────────────────────────────────────────────────────────────

# Wallet runtime tuning (optional — defaults in code)
# All values are integers.

# Rate-limit windows — override the defaults in rateLimiter.ts
# RL_GET_BALANCE_MAX=30
# RL_SPEND_COINS_MAX=20
# RL_INITIATE_PURCHASE_MAX=10
# RL_VERIFY_PURCHASE_MAX=10

# Fraud risk scoring — override thresholds in riskScoringService.ts
# RISK_THROTTLE_THRESHOLD=30
# RISK_REVIEW_THRESHOLD=60
# RISK_FREEZE_THRESHOLD=80

# Admin auto-execute cap (low-value maker self-execute, in coins)
# ADMIN_AUTO_EXECUTE_THRESHOLD=10

# Sandbox payment provider — currently always "sandbox" until real providers wire in.
PAYMENT_PROVIDER=sandbox

# Set to "true" to enable verbose audit logging in development.
MINDOS_AUDIT_VERBOSE=false
