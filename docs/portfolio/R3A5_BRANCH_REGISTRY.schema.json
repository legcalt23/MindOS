{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "R3A5_BRANCH_REGISTRY.schema.json",
  "title": "R3-A5 §1 branch registry — the declarative authority for the Phase 8 obligation inventory",
  "description": "The JSON registry is the authority. No .mjs may be both the data authority and its own validator, and no total may be hand-written: every count is computed by validate-branch-registry.mjs from these rows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registrySchemaVersion", "generatedFrom", "authorityNote", "rows", "legacyInventory"],
  "properties": {
    "registrySchemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowRunId", "sourceSnapshotId", "note"],
      "properties": {
        "workflowRunId": { "type": "string" },
        "sourceSnapshotId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "note": { "type": "string" }
      }
    },
    "authorityNote": { "type": "string" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/row" }
    },
    "legacyInventory": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/legacy" }
    }
  },
  "definitions": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowId", "legacyIds", "originStage", "structuralType", "sourceFile", "sourceFileSha256",
        "sourceLocation", "exactExpression", "candidateProperty", "authorityStatus", "d1Classification",
        "classificationHistory", "disposition", "mergedInto", "delegatedContract", "owner",
        "testStatus", "testIds", "evidenceIds", "dependencies", "rationale", "proof", "notes"
      ],
      "properties": {
        "rowId": { "type": "string", "pattern": "^R-[0-9]{3}$" },
        "legacyIds": { "type": "array", "items": { "type": "string" } },
        "originStage": { "type": "string", "enum": ["R3A4_WORKFLOW", "R3A5_TRUST_BOUNDARY_ANALYSIS"] },
        "structuralType": {
          "type": "string",
          "enum": [
            "LOCAL_PREDICATE", "SHARED_BINDING", "TRUST_BOUNDARY", "DELEGATED_CHILD_REQUIREMENT",
            "FAULT_ABORT_SCENARIO", "DISCARDED_SIGNAL", "AUTHORITY_DIFF_INVARIANT", "CRYPTOGRAPHIC_TRUST_ASSUMPTION"
          ]
        },
        "sourceFile": { "type": "string" },
        "sourceFileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceLocation": { "type": "string" },
        "exactExpression": { "type": "string", "minLength": 1 },
        "candidateProperty": { "type": "string" },
        "authorityStatus": { "type": "string", "enum": ["CONTRACT_PENDING", "CONTRACT_APPROVED"] },
        "d1Classification": {
          "type": "string",
          "enum": [
            "REQUIRED_FALSIFIABLE", "REDUNDANT_OR_IMPLIED", "DEAD_OR_UNREACHABLE",
            "CRYPTOGRAPHIC_ASSUMPTION", "DIFF_OR_AUTHORITY_ONLY", "DEFECT_DISCARDED_SIGNAL"
          ]
        },
        "classificationHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "reason"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "disposition": {
          "type": "string",
          "enum": ["KEEP", "DELETE", "REDESIGN", "INCORPORATE", "DELEGATE_TO_CHILD_CONTRACT", "MOVE_TO_FAULT_MATRIX", "MERGED_INTO", "SUPERSEDED"]
        },
        "mergedInto": { "type": ["string", "null"] },
        "delegatedContract": { "type": ["string", "null"] },
        "owner": { "type": "string", "minLength": 1 },
        "testStatus": {
          "type": "string",
          "enum": [
            "TEST_NOT_DESIGNED", "TEST_DESIGNED_NOT_RUN", "TEST_PRESENT_NOT_DISCRIMINATING",
            "REPRODUCED_UNBOUND", "DISCRIMINATING_VERIFIED", "PROOF_PENDING", "PROOF_VERIFIED",
            "DIFF_GATE_PENDING", "DELEGATED_GATE_PENDING"
          ]
        },
        "testIds": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 },
        "proof": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacyId", "origin", "exactExpression", "sourceArtifact", "disposition", "canonicalRow", "reason"],
      "properties": {
        "legacyId": { "type": "string", "pattern": "^P8-[0-9]{2}\\.b[0-9]$" },
        "origin": { "type": "string" },
        "exactExpression": { "type": "string", "minLength": 1 },
        "sourceArtifact": { "type": "string" },
        "disposition": {
          "type": "string",
          "enum": ["KEPT", "MERGED", "DELEGATED", "MOVED_TO_FAULT_MATRIX", "CONVERTED_TO_DEFECT", "REMOVED_AS_DUPLICATE", "REMOVED_WITH_PROOF", "UNRECOVERABLE"]
        },
        "canonicalRow": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
