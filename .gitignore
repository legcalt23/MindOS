# ── Gradle / Kotlin / Android ──────────────────────────────────────────
*.iml
.gradle
.kotlin
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
/build
**/build/
/captures
.externalNativeBuild
.cxx
local.properties
tmp_decompile/

# ── OS ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Node / Functions ───────────────────────────────────────────────────
node_modules/
functions/lib/
functions/coverage/

# ── Secrets — never commit any of these ────────────────────────────────
# .env files (real values). .env.example IS committed (no secrets).
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.staging

# Firebase service-account / admin keys
firebase-adminsdk-*.json
serviceAccountKey*.json
*-service-account*.json
google-services-secrets.json

# Generic credential / private-key patterns
*.pem
*.p12
*.key
*_rsa
*_rsa.pub
id_rsa*
*.pfx

# Android signing keystores — NEVER commit. Distribute via secure channel
# (1Password / secrets vault / encrypted backup). See gradle.properties.example
# for the variable names the signing config reads.
*.jks
*.keystore
key.properties
keystore.properties
release-keystore.properties
# Root gradle.properties may hold real keystore credentials on a dev machine.
# The committed gradle.properties at repo root only holds non-secret JVM options
# — it stays tracked. Any developer-local overrides go to ~/.gradle/gradle.properties.
/androidApp/keystore/
/androidApp/*.jks
/androidApp/*.keystore

# ── Logs / debug artifacts ────────────────────────────────────────────
*.log
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
build_log*.txt
build_output*.log
build_appcheck.log

# Local emulator state
.firebase/
firestore-export/

# ── IDE / editor swap files ───────────────────────────────────────────
.idea/
*.swp
*.swo
*.bak
*~

# ── Built / generated KMP artifacts at repo root ──────────────────────
*.class
androidApp/release/*.apk
